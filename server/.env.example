SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_KEY=your-supabase-publishable-or-anon-key
# Required for admin account creation and identity verification. Keep server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional: public HTTPS URL of a separately deployed identity processor.
IDENTITY_VERIFICATION_URL=https://YOUR-IDENTITY-PROCESSOR.onrender.com
IDENTITY_VERIFICATION_TOKEN=replace-with-a-random-shared-secret
PORT=3000
