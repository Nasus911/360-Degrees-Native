{
  "expo": {
    "name": "client",
    "slug": "client",
    "version": "1.0.0",
    "scheme": [
      "degrees360"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow 360 Degrees to scan reward codes and capture a face for identity verification.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-image-picker",
      "expo-status-bar",
      "@rbayuokt/expo-face-vision"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.naxus911.client"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "80c64847-0d42-4b50-b8ed-b3db76630110"
      }
    },
    "owner": "naxus911",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/80c64847-0d42-4b50-b8ed-b3db76630110"
    }
  }
}
